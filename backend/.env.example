APP_NAME=Project Elysia
APP_VERSION=0.4.0
ENVIRONMENT=development
DEBUG=true
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
# DATABASE_URL defaults to backend/data/elysia.db when omitted.
LOG_LEVEL=INFO
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Set this to an exact model name already returned by `ollama list`.
OLLAMA_MODEL=
OLLAMA_CONNECT_TIMEOUT_SECONDS=3
OLLAMA_READ_TIMEOUT_SECONDS=120
OLLAMA_KEEP_ALIVE=5m
OLLAMA_TEMPERATURE=0.8
OLLAMA_TOP_P=0.9
OLLAMA_TOP_K=40
OLLAMA_REPEAT_PENALTY=1.1
OLLAMA_CONTEXT_SIZE=4096
OLLAMA_MAX_OUTPUT_TOKENS=700
OLLAMA_STATUS_CACHE_TTL_SECONDS=10
CONVERSATION_RECENT_MESSAGE_LIMIT=20
CONVERSATION_LIST_DEFAULT_LIMIT=20
CONVERSATION_LIST_MAX_LIMIT=100
MESSAGE_LIST_DEFAULT_LIMIT=50
MESSAGE_LIST_MAX_LIMIT=200
MESSAGE_MAX_CONTENT_LENGTH=10000
CONVERSATION_LOCK_TIMEOUT_SECONDS=1
STREAM_MAX_ACCUMULATED_CHARACTERS=50000
